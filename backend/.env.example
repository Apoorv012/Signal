# Copy to .env to override defaults (all optional; see app/core/config.py).

# SQLite file. In production point this at a persistent volume, e.g. sqlite:////data/signal.db
DATABASE_URL=sqlite:///./data/signal.db
# Uploaded files (avatars, attachments) and the copied seed media.
MEDIA_DIR=./data/media

# Allowed browser origins (JSON list). Add the deployed frontend URL here.
CORS_ORIGINS=["http://localhost:3000"]

# Mocked verification code accepted for every phone number.
FIXED_OTP=123456
SESSION_TTL_DAYS=30

# Seed demo users / chats when the database is empty.
SEED_ON_STARTUP=true
MAX_UPLOAD_BYTES=26214400
